{
  "name": "personal-story-generator",
  "version": "1.0.0",
  "description": "Personal AI Story Generator — 2–6 minute voiceover-ready stories powered by Groq and LangGraph",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "lint:fix": "eslint src tests scripts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:groq": "tsx scripts/test-groq.ts",
    "groq:models": "tsx scripts/discover-groq.ts",
    "test:bedrock": "tsx scripts/test-bedrock.ts",
    "bedrock:discover": "tsx scripts/discover-bedrock.ts",
    "test:smoke": "tsx tests/smoke/live-generation.ts",
    "db:setup:local": "tsx scripts/setup-local-dynamo.ts",
    "seed:presets": "tsx scripts/seed-presets.ts",
    "frontend:dev": "npm run dev --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "frontend:start": "npm run start --prefix frontend"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.699.0",
    "@aws-sdk/lib-dynamodb": "^3.699.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@langchain/core": "^0.3.26",
    "@langchain/groq": "^0.1.3",
    "@langchain/langgraph": "^0.2.36",
    "fastify": "^4.28.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "@vitest/coverage-v8": "^2.1.5",
    "eslint": "^9.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
