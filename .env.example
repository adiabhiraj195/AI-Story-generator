# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# ─── General AWS Credentials & Configuration ────────────────────────────────
# Shared AWS region for AWS services (DynamoDB, Bedrock)
AWS_REGION=us-east-1

# AWS CLI named profile (e.g. bedrock-dev from ~/.aws/credentials)
# Uses the official AWS SDK credential provider chain.
AWS_PROFILE=bedrock-dev

# General AWS API Key credentials (fallback for Bedrock & DynamoDB)
# When provided, these keys are explicitly passed into AWS SDK clients.
# If left blank, the SDK falls back to the ambient credential chain (AWS_PROFILE, ~/.aws/credentials, or IAM role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ─── Groq (AI Generation Configuration) ──────────────────────────────────────
# Obtain your free API key at: https://console.groq.com/keys
GROQ_API_KEY=

# Default model — used as fallback when WRITER/EVALUATOR are unset
# Supported models:
#   Meta Llama 3.3 70B:           llama-3.3-70b-versatile  (Recommended - fast, high quality)
#   Meta Llama 3.1 8B:            llama-3.1-8b-instant    (Ultra-fast, low latency)
#   Meta Llama 3.2 3B:            llama-3.2-3b-preview
#   Meta Llama 3.2 1B:            llama-3.2-1b-preview
#   Mistral Mixtral 8x7B:         mixtral-8x7b-32768
#   Google Gemma 2 9B:            gemma2-9b-it
#   DeepSeek R1 Distill 70B:      deepseek-r1-distill-llama-70b
GROQ_MODEL=llama-3.3-70b-versatile

# Dedicated writer model (high-creativity, ~4096 token output)
GROQ_WRITER_MODEL=llama-3.3-70b-versatile

# Dedicated evaluator model (low-temperature, analytical)
GROQ_EVALUATOR_MODEL=llama-3.3-70b-versatile

# Max output tokens per model role
GROQ_WRITER_MAX_TOKENS=4096
GROQ_EVALUATOR_MAX_TOKENS=2048

# ─── DynamoDB (Database API Keys & Configuration) ────────────────────────────
# Dedicated Database API Keys (overrides general AWS keys if set)
# Pass your DynamoDB-specific access key and secret key here (DB key):
DYNAMODB_ACCESS_KEY_ID=
DYNAMODB_SECRET_ACCESS_KEY=
DYNAMODB_SESSION_TOKEN=

# Optional: local DynamoDB endpoint (leave blank for real AWS DynamoDB)
# DYNAMODB_ENDPOINT=http://localhost:8000

# DynamoDB Table Names
DYNAMODB_STORIES_TABLE=personal-story-generator-stories
DYNAMODB_PRESETS_TABLE=personal-story-generator-presets
DYNAMODB_GENERATIONS_TABLE=personal-story-generator-generations

# ─── LangSmith (Optional LLM Observability / Tracing) ────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=personal-story-generator
